{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests;examples"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (Apple Clang)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release (Apple Clang)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (MSVC)",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "static",
      "hidden": true,
      "description": "Elegance as a static library, linked into each app (no hot reload)",
      "cacheVariables": {
        "ELG_BUILD_SHARED": "OFF"
      }
    },
    {
      "name": "windows-release-static",
      "displayName": "Windows Release, static (MSVC)",
      "inherits": ["static", "windows-release"]
    },
    {
      "name": "fully-static",
      "hidden": true,
      "description": "Everything static, the C runtime included: each app is one executable (plus the optional DirectX shader compiler DLLs)",
      "inherits": "static",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-release-fully-static",
      "displayName": "Windows Release, fully static (MSVC)",
      "description": "Release without debug info: statically linked, each app's PDB would carry all of Dawn's (~700 MB)",
      "inherits": ["fully-static", "windows-release"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-release-static",
      "displayName": "macOS Release, static (Apple Clang)",
      "inherits": ["static", "macos-release"]
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "windows-release-static",
      "configurePreset": "windows-release-static"
    },
    {
      "name": "windows-release-fully-static",
      "configurePreset": "windows-release-fully-static"
    },
    {
      "name": "macos-release-static",
      "configurePreset": "macos-release-static"
    }
  ]
}
