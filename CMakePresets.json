{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (MSVC, shared)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "ELG_BUILD_TESTS": false,
                "ELG_BUILD_SANDBOX": false,
                "ELG_ACCESSIBILITY": true,
                "ELG_ACCESSKIT_SHARED": true
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug (Apple Silicon, shared)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release (Apple Silicon, static)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (MSVC, static)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "description": "GCC 14+ or Clang 18+; vcpkg picks the triplet for the host (x64-linux, arm64-linux)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (shared)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (static)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "static",
            "hidden": true,
            "description": "Elegance as a static library, linked into each app (no hot reload)",
            "cacheVariables": {
                "ELG_BUILD_SHARED": "OFF"
            }
        },
        {
            "name": "windows-release-static",
            "displayName": "Windows Release, static (MSVC)",
            "inherits": [
                "static",
                "windows-release"
            ]
        },
        {
            "name": "fully-static",
            "hidden": true,
            "description": "Everything static, the C runtime included: each app is one executable (plus the optional DirectX shader compiler DLLs)",
            "inherits": "static",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            }
        },
        {
            "name": "windows-release-fully-static",
            "displayName": "Windows Release, fully static (MSVC)",
            "description": "Release without debug info: statically linked, each app's PDB would carry all of Dawn's (~700 MB)",
            "inherits": [
                "fully-static",
                "windows-release"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-release-static",
            "displayName": "macOS Release, static (Apple Silicon)",
            "inherits": [
                "static",
                "macos-release"
            ]
        },
        {
            "name": "local-offline-static",
            "displayName": "macOS Release, existing offline dependencies (Apple Silicon)",
            "description": "Reuse the local-offline-static dependency installation and AccessKit sources; requires that build to have been populated already.",
            "inherits": "macos-release-static",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/build/local-offline-static/vcpkg_installed",
                "VCPKG_MANIFEST_INSTALL": false,
                "FETCHCONTENT_SOURCE_DIR_ACCESSKIT_C": "${sourceDir}/build/local-offline-static/_deps/accesskit_c-src"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "jobs": 8,
            "targets": [
                "elegance"
            ]
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "jobs": 8,
            "targets": [
                "elegance"
            ]
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "windows-release-static",
            "configurePreset": "windows-release-static"
        },
        {
            "name": "windows-release-fully-static",
            "configurePreset": "windows-release-fully-static"
        },
        {
            "name": "macos-release-static",
            "configurePreset": "macos-release-static",
            "jobs": 8,
            "targets": [
                "elegance"
            ]
        },
        {
            "name": "local-offline-static",
            "configurePreset": "local-offline-static",
            "jobs": 8,
            "targets": [
                "elegance"
            ]
        }
    ]
}
