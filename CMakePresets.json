{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "description": "cmake/ElgBootstrap.cmake picks the vcpkg toolchain: $VCPKG_ROOT, or a clone it manages"
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (MSVC, shared)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "VCPKG_MANIFEST_FEATURES": "tests",
                "ELG_ACCESSIBILITY": true,
                "ELG_ACCESSKIT_SHARED": true
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug (Apple Silicon, shared)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release (Apple Silicon, static)",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (MSVC, static)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "description": "GCC 14+ or Clang 18+; vcpkg picks the triplet for the host (x64-linux, arm64-linux)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "VCPKG_MANIFEST_FEATURES": "tests"
            }
        },
        {
            "name": "linux-clang-libcxx-base",
            "hidden": true,
            "inherits": "linux-base",
            "description": "Clang and libc++; the build adds what libc++ needs and builds the dependencies against it. Pick a Clang 19 or later with -DCMAKE_CXX_COMPILER=clang++-19 -DCMAKE_C_COMPILER=clang-19 where clang++ is older.",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++"
            }
        },
        {
            "name": "linux-clang-libcxx-debug",
            "displayName": "Linux Debug, Clang and libc++ (shared)",
            "inherits": "linux-clang-libcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "linux-clang-libcxx-release",
            "displayName": "Linux Release, Clang and libc++ (static)",
            "inherits": "linux-clang-libcxx-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "linux-clang-libcxx-asan",
            "displayName": "Linux, Clang and libc++, AddressSanitizer and UBSan (static)",
            "inherits": "linux-clang-libcxx-release",
            "cacheVariables": {
                "ELG_SANITIZER": "address"
            }
        },
        {
            "name": "linux-clang-libcxx-tsan",
            "displayName": "Linux x64, Clang and libc++, ThreadSanitizer (static)",
            "inherits": "linux-clang-libcxx-release",
            "cacheVariables": {
                "ELG_SANITIZER": "thread",
                "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx-tsan"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (shared)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ELG_BUILD_SHARED": true
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (static)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ELG_BUILD_SHARED": false
            }
        },
        {
            "name": "static",
            "hidden": true,
            "description": "Elegance as a static library, linked into each app (no hot reload)",
            "cacheVariables": {
                "ELG_BUILD_SHARED": "OFF"
            }
        },
        {
            "name": "windows-release-static",
            "displayName": "Windows Release, static (MSVC)",
            "inherits": [
                "static",
                "windows-release"
            ]
        },
        {
            "name": "fully-static",
            "hidden": true,
            "description": "Everything static, the C runtime included: each app is one executable (plus the optional DirectX shader compiler DLLs)",
            "inherits": "static",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            }
        },
        {
            "name": "windows-release-fully-static",
            "displayName": "Windows Release, fully static (MSVC)",
            "description": "Release without debug info: statically linked, each app's PDB would carry all of Dawn's (~700 MB)",
            "inherits": [
                "fully-static",
                "windows-release"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-asan",
            "displayName": "macOS, AddressSanitizer and UBSan (static, Apple Silicon)",
            "inherits": "macos-release",
            "cacheVariables": {
                "ELG_SANITIZER": "address"
            }
        },
        {
            "name": "macos-tsan",
            "displayName": "macOS, ThreadSanitizer (static, Apple Silicon)",
            "inherits": "macos-release",
            "cacheVariables": {
                "ELG_SANITIZER": "thread",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-tsan"
            }
        },
        {
            "name": "macos-release-static",
            "displayName": "macOS Release, static (Apple Silicon)",
            "inherits": [
                "static",
                "macos-release"
            ]
        }
    ]
}
