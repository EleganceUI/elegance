# Hot reload (design.md §9.6).
#
# elegence_views_module(<target> <sources>...)
#
#   A views module: a shared library holding an app's views, with ELG_MODULE(...) in one source
#   file. It links the shared Elegence library, like the app that loads it.
#
# elegence_hot_reload(<host> MODULE <views target> [WATCH <files or folders>...])
#
#   Lets <host> show <views target> with HotReload(): generates <host>_hot_reload.h, which
#   defines elg_hot_reload_options() with where the module is built, the command that rebuilds
#   it, and the folders to watch (default: the module's source folder).
#
#     #include "app_hot_reload.h"
#     app.window({.title = "App"}, [] { return elg::HotReload(elg_hot_reload_options()); });
# Hot reload swaps a module that shares the host's Elegence: a static Elegence would give each
# its own copy (its own state, windows, and renderer).
function(_elegence_require_shared what)
    get_target_property(type Elegence::Elegence TYPE)
    if (type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "${what}: hot reload needs Elegence as a shared library (ELG_BUILD_SHARED=ON)")
    endif ()
endfunction()

function(elegence_views_module target)
    _elegence_require_shared("elegence_views_module(${target})")
    add_library(${target} SHARED ${ARGN})
    target_link_libraries(${target} PRIVATE Elegence::Elegence)
endfunction()

function(elegence_hot_reload host)
    _elegence_require_shared("elegence_hot_reload(${host})")
    cmake_parse_arguments(ARG "" "MODULE" "WATCH" ${ARGN})
    if (NOT ARG_MODULE)
        message(FATAL_ERROR "elegence_hot_reload(${host}): MODULE <views target> is required")
    endif ()
    if (NOT ARG_WATCH)
        get_target_property(ARG_WATCH ${ARG_MODULE} SOURCE_DIR)
    endif ()
    set(watch_lines "")
    foreach (path IN LISTS ARG_WATCH)
        cmake_path(ABSOLUTE_PATH path NORMALIZE OUTPUT_VARIABLE absolute)
        string(APPEND watch_lines "    options.watch.push_back(R\"elg(${absolute})elg\");\n")
    endforeach ()

    # The build command rebuilds just the module, in this build tree and configuration.
    set(build "\"${CMAKE_COMMAND}\" --build \"${CMAKE_BINARY_DIR}\" --target ${ARG_MODULE}")
    get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if (multi_config)
        string(APPEND build " --config $<CONFIG>")
    endif ()

    # An app started from an IDE or Explorer may lack the compiler's environment (MSVC needs
    # vcvars' INCLUDE, LIB, and PATH): the rebuild script restores the one this tree was
    # configured with.
    if (WIN32 AND DEFINED ENV{INCLUDE})
        set(script "${CMAKE_CURRENT_BINARY_DIR}/${host}_hot_reload/rebuild.cmd")
        set(content "@echo off\r\n")
        foreach (variable IN ITEMS INCLUDE LIB LIBPATH PATH)
            if (DEFINED ENV{${variable}})
                string(APPEND content "set \"${variable}=$ENV{${variable}}\"\r\n")
            endif ()
        endforeach ()
        string(APPEND content "${build}\r\n")
        file(GENERATE OUTPUT "${script}" CONTENT "${content}")
        set(build "\"${script}\"")
    endif ()

    set(header "${CMAKE_CURRENT_BINARY_DIR}/${host}_hot_reload/${host}_hot_reload.h")
    file(GENERATE OUTPUT "${header}" CONTENT
"// Generated by elegence_hot_reload(); don't edit.
#pragma once
#include <elg/hot_reload.h>

inline elg::HotReloadOptions elg_hot_reload_options() {
    elg::HotReloadOptions options;
    options.module = R\"elg($<TARGET_FILE:${ARG_MODULE}>)elg\";
    options.build_command = R\"elg(${build})elg\";
${watch_lines}    return options;
}
")
    target_include_directories(${host} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/${host}_hot_reload")
    # Built with the host, so it's there on the first run.
    add_dependencies(${host} ${ARG_MODULE})
endfunction()
