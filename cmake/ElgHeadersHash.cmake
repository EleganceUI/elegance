# Writes HEADER, <elg/headers_hash.h>, with a hash of the public headers under ROOT/include/elg:
# their paths and contents. The build runs it when one of them changes, then touches STAMP.
# HEADER is left alone when the hash is the same, so what includes it isn't compiled again.
#
#   cmake -DROOT=<source folder> -DHEADER=<file> -DSTAMP=<file> -P ElgHeadersHash.cmake

file(GLOB_RECURSE headers RELATIVE "${ROOT}" "${ROOT}/include/elg/*.h")
list(SORT headers)
set(text "")
foreach (header IN LISTS headers)
    file(READ "${ROOT}/${header}" content HEX)
    string(APPEND text "${header}\n${content}\n")
endforeach ()
string(SHA256 hash "${text}")
string(SUBSTRING "${hash}" 0 16 hash)

set(content "// Generated by the build from Elegance's public headers (include/elg); don't edit.
#ifndef ELG_HEADERS_HASH_H
#define ELG_HEADERS_HASH_H

#include <cstdint>

namespace elg::detail {
// A hash of the public headers' paths and contents: code compiled with the same one saw the same
// headers (ModuleEntry::elegance_hash).
inline constexpr std::uint64_t headers_hash = 0x${hash}ull;
} // namespace elg::detail

#endif // ELG_HEADERS_HASH_H
")
set(old "")
if (EXISTS "${HEADER}")
    file(READ "${HEADER}" old)
endif ()
if (NOT old STREQUAL content)
    file(WRITE "${HEADER}" "${content}")
endif ()
file(TOUCH "${STAMP}")
