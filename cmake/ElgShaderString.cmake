# Script mode (cmake -P): writes OUTPUT, INPUT's text as a C++ string literal (adjacent raw
# string literals, one per line). Run at build time by elg_add_shaders() (ElgShaders.cmake).
# Splitting by line keeps each literal far below MSVC's 16 KB limit per literal.
# (Read whole, not with file(STRINGS): that would split the text into a list at semicolons.)

file(READ "${INPUT}" text)
string(REPLACE "\r" "" text "${text}")
string(REPLACE "\n" "\n)elg_wgsl\"\nR\"elg_wgsl(" text "${text}")

file(WRITE "${OUTPUT}"
     "// Generated by cmake/ElgShaderString.cmake from ${INPUT}; do not edit.\nR\"elg_wgsl(${text})elg_wgsl\"\n")
