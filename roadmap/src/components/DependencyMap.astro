// Every spec, by part: what it depends on directly, what depends on it, and the earliest "wave"
// it can be built in (one more than its deepest dependency), from the specs' `depends` frontmatter.
import { graph, href, ordered, SPEC_PREFIX } from '../graph';
import { sections } from '../sections.mjs';

const nodes = await graph();
const wave = new Map<string, number>();
const waveOf = (key: string): number => {
	if (!wave.has(key)) {
		const deps = nodes.get(key)!.depends;
		wave.set(key, deps.length ? Math.max(...deps.map(waveOf)) + 1 : 1);
	}
	return wave.get(key)!;
};
const rows = ordered(nodes).map((node) => ({ ...node, wave: waveOf(node.key) }));
const waves = Math.max(0, ...rows.map((row) => row.wave));
const byWave = Array.from({ length: waves }, (_, i) => rows.filter((row) => row.wave === i + 1));
const label = (key: string) => nodes.get(key)!.title;
const link = (key: string) => href(SPEC_PREFIX + key);
---

<h2 id="waves">Build waves</h2>
<p>
	Everything in a wave depends only on earlier waves, so the pages within one wave can be built in
	any order (or in parallel).
</p>
<ol class="roadmap-waves">
	{
		byWave.map((group, i) => (
			<li>
				<strong>Wave {i + 1}:</strong>{' '}
				{group.map((row, j) => (
					<>
						{j > 0 && ' · '}
						<a href={link(row.key)}>{row.title}</a>
					</>
				))}
			</li>
		))
	}
</ol>

<h2 id="by-part">By part</h2>
{
	sections.map(({ dir, label: part }) => {
		const inPart = rows.filter((row) => row.part === dir);
		return (
			inPart.length > 0 && (
				<>
					<h3>{part}</h3>
					<table class="roadmap-deptable">
						<thead>
							<tr>
								<th>Spec</th>
								<th>Wave</th>
								<th>Depends on</th>
								<th>Needed by</th>
							</tr>
						</thead>
						<tbody>
							{inPart.map((row) => (
								<tr>
									<td>
										<a href={link(row.key)}>{row.title}</a>
									</td>
									<td>{row.wave}</td>
									<td>{row.depends.length ? row.depends.map(label).join(', ') : '—'}</td>
									<td>{row.neededBy.length ? row.neededBy.map(label).join(', ') : '—'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</>
			)
		);
	})
}
