// Progress across every page, by part, plus backing up and restoring the ticks.
import { getCollection } from 'astro:content';
import { sections } from '../sections.mjs';
import { countTasks } from '../tasks';

const entries = await getCollection('docs');
const ids = new Set(entries.map((entry) => entry.id));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = sections.map(({ dir, label }) => ({
	label,
	pages: entries
		.filter((entry) => entry.id.startsWith(`${dir}/`))
		.map((entry) => ({
			id: entry.id,
			title: entry.data.title,
			order: entry.data.sidebar?.order ?? 999,
			total: countTasks(entry.body ?? ''),
			href: `${base}/${entry.id}/`,
			spec: ids.has(`how/${entry.id}`) ? `${base}/how/${entry.id}/` : undefined,
		}))
		.filter((page) => page.total > 0)
		.sort((a, b) => a.order - b.order),
}));
const total = groups.flatMap((group) => group.pages).reduce((sum, page) => sum + page.total, 0);
---

<div class="roadmap-overview">
	<div class="roadmap-bar roadmap-overall" data-total={total}>
		<div class="roadmap-meter" aria-hidden="true"><div class="roadmap-meter-fill"></div></div>
		<span class="roadmap-count" aria-live="polite">0 / {total} done</span>
	</div>

	{
		groups.map((group) => (
			<section class="roadmap-group">
				<h3>{group.label}</h3>
				<ul>
					{group.pages.map((page) => (
						<li class="roadmap-row" data-page={page.id} data-total={page.total}>
							<span class="roadmap-row-title">
								<a href={page.href}>{page.title}</a>
								{page.spec && (
									<a class="roadmap-row-spec" href={page.spec}>
										How it works
									</a>
								)}
							</span>
							<div class="roadmap-meter" aria-hidden="true">
								<div class="roadmap-meter-fill" />
							</div>
							<span class="roadmap-count">0 / {page.total}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}

	<div class="roadmap-actions">
		<button type="button" data-action="export">Export progress</button>
		<label class="roadmap-import">
			Import progress
			<input type="file" accept="application/json,.json" data-action="import" />
		</label>
		<button type="button" data-action="reset">Reset all</button>
	</div>
</div>

<script>
	import { doneCount, isProgress, load, save } from '../scripts/progress';

	const setMeter = (element: HTMLElement, done: number, total: number, label: (d: number, t: number) => string) => {
		const percent = total ? Math.round((done / total) * 100) : 0;
		element.querySelector<HTMLElement>('.roadmap-meter-fill')!.style.width = `${percent}%`;
		element.querySelector<HTMLElement>('.roadmap-count')!.textContent = label(done, total);
		element.classList.toggle('complete', total > 0 && done === total);
	};

	const render = () => {
		const progress = load();
		let all = 0;
		document.querySelectorAll<HTMLElement>('.roadmap-row').forEach((row) => {
			const total = Number(row.dataset.total);
			const done = Math.min(doneCount(progress, row.dataset.page!), total);
			all += done;
			setMeter(row, done, total, (d, t) => `${d} / ${t}`);
		});
		const overall = document.querySelector<HTMLElement>('.roadmap-overall')!;
		setMeter(overall, all, Number(overall.dataset.total), (d, t) => `${d} / ${t} done (${t ? Math.round((d / t) * 100) : 0}%)`);
	};

	document.querySelector('[data-action="export"]')?.addEventListener('click', () => {
		const blob = new Blob([JSON.stringify(load(), null, 2)], { type: 'application/json' });
		const link = document.createElement('a');
		link.href = URL.createObjectURL(blob);
		link.download = `elegance-roadmap-${new Date().toISOString().slice(0, 10)}.json`;
		link.click();
		URL.revokeObjectURL(link.href);
	});

	document.querySelector<HTMLInputElement>('[data-action="import"]')?.addEventListener('change', async (event) => {
		const input = event.currentTarget as HTMLInputElement;
		const file = input.files?.[0];
		input.value = '';
		if (!file) {
			return;
		}
		try {
			const parsed: unknown = JSON.parse(await file.text());
			if (!isProgress(parsed)) {
				throw new Error('not a roadmap progress file');
			}
			save(parsed);
			render();
		} catch (error) {
			alert(`Couldn't import: ${(error as Error).message}`);
		}
	});

	document.querySelector('[data-action="reset"]')?.addEventListener('click', () => {
		if (confirm('Clear every tick on every page? Export first if you might want them back.')) {
			const progress = load();
			save({ ...progress, pages: {} });
			render();
		}
	});

	render();
	// Coming back to this tab after ticking items elsewhere.
	window.addEventListener('pageshow', render);
	window.addEventListener('storage', render);
</script>
