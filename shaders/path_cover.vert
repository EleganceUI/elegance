#version 450

// Path coverage, step 2 (cover): one triangle over the whole mask; the stencil test keeps the
// samples inside the path.
void main() {
    vec2 corner = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);
}
