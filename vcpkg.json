{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "elegance",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "builtin-baseline": "2750401336fb7c95f6619657a46a7e798661341c",
  "dependencies": [
    {
      "name": "dawn",
      "features": [
        {
          "name": "wayland",
          "platform": "linux | freebsd | openbsd | (!windows & !osx & !ios & !android & !linux & !freebsd & !openbsd & !emscripten & !uwp)"
        }
      ]
    },
    {
      "name": "boost-asio",
      "default-features": false,
      "features": [
        "ssl"
      ]
    },
    "boost-beast",
    "boost-url",
    "openssl",
    "freetype",
    "harfbuzz",
    "miniaudio",
    {
      "name": "msdfgen",
      "default-features": false
    },
    {
      "name": "stb",
      "platform": "!windows & !osx"
    },
    "sdl3",
    "accesskit-c"
  ],
  "features": {
    "tests": {
      "description": "Build the unit tests",
      "dependencies": [
        "catch2"
      ]
    },
    "profiling": {
      "description": "Build for the Tracy profiler (ELG_TRACY)",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  }
}
